{
  "name": "campus-cat-platform",
  "version": "3.11.3",
  "description": "校园猫咪信息管理平台（微信小程序 + 云开发）",
  "license": "AGPL-3.0",
  "private": true,
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js --max-warnings 86",
    "lint:fix": "eslint . --ext .js --fix",
    "stylelint": "stylelint \"**/*.wxss\"",
    "stylelint:fix": "stylelint \"**/*.wxss\" --fix",
    "remove-bom": "node scripts/remove-bom.js",
    "build-cloud": "node scripts/build-cloud.js build",
    "build-cloud:copy": "node scripts/build-cloud.js copy",
    "build-cloud:clean": "node scripts/build-cloud.js clean",
    "build-cloud:verify": "node scripts/build-cloud.js verify",
    "build-cloud:sync-utils": "node scripts/sync-utils.js",
    "build-cloud:verify-sync": "node scripts/sync-utils.js --check",
    "prepare": "npm run remove-bom",
    "check": "npm run version:check && npm run check:pack && npm run lint && npm run stylelint && npm run test && npm run check:icons && npm run check:guidance && npm run build-cloud:verify && npm run build-cloud:verify-sync",
    "check:pack": "node scripts/check-pack-size.js",
    "version:check": "node scripts/version.js check",
    "build:icons": "node scripts/build-icons.js",
    "check:icons": "node scripts/check-ui-emoji.js",
    "check:guidance": "node scripts/check-guidance.js",
    "check:contrast": "node scripts/check-contrast.js",
    "check:contrast:strict": "node scripts/check-contrast.js --strict",
    "check:design": "node scripts/check-design-tokens.js",
    "check:dead-css": "node scripts/check-dead-css.js",
    "recolor-icon": "node scripts/recolor-png-icon.js"
  },
  "devDependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "eslint": "^8.57.0",
    "fontkit": "^2.0.4",
    "jest": "^29.7.0",
    "pngjs": "^7.0.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-order": "^6.0.0",
    "subset-font": "^2.9.0"
  },
  "dependencies": {}
}
