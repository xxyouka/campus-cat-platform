<view class="page page-enter">
  <custom-navbar title="操作日志" theme="warm" showBack="{{true}}" subtitle="查看管理员所有操作记录" />

  <view class="stats-bar" wx:if="{{total > 0}}">
    <view class="stat-tag" wx:for="{{modules}}" wx:key="value" wx:if="{{item.value && stats[item.value]}}">
      <text class="stat-tag-text">{{item.label}}: {{stats[item.value]}}</text>
    </view>
  </view>

  <view class="filter-bar">
    <view class="filter-trigger {{hasActiveFilter ? 'active' : ''}}" bindtap="onToggleFilter">
      <icon name="search" size="28" />
      <text class="filter-text">{{hasActiveFilter ? '已筛选' : '筛选条件'}}</text>
      <text class="filter-count" wx:if="{{total > 0}}">{{total}}条</text>
    </view>
    <view class="filter-toggle" bindtap="onToggleFilter">
      <text class="toggle-arrow {{showFilterPanel ? 'open' : ''}}">▼</text>
    </view>
  </view>

  <view class="filter-panel {{showFilterPanel ? 'show' : ''}}">
    <view class="filter-row">
      <view class="filter-item half">
        <text class="filter-label">管理员账号</text>
        <input class="filter-input" placeholder="输入管理员账号" value="{{filters.adminAccount}}" bindinput="onAccountInput" maxlength="50" confirm-type="next" />
      </view>
      <view class="filter-item half">
        <text class="filter-label">操作模块</text>
        <picker mode="selector" range="{{modulesLabels}}" value="{{moduleIndex}}" bindchange="onModuleChange">
          <view class="filter-picker">
            <text class="{{filters.module ? '' : 'placeholder'}}">{{modules[moduleIndex].label}}</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="filter-row">
      <view class="filter-item half">
        <text class="filter-label">操作类型</text>
        <picker mode="selector" range="{{actionsLabels}}" value="{{actionIndex}}" bindchange="onActionChange">
          <view class="filter-picker">
            <text class="{{filters.action ? '' : 'placeholder'}}">{{actions[actionIndex].label}}</text>
          </view>
        </picker>
      </view>
      <view class="filter-item half">
        <text class="filter-label">操作结果</text>
        <picker mode="selector" range="{{resultsLabels}}" value="{{resultIndex}}" bindchange="onResultChange">
          <view class="filter-picker">
            <text class="{{filters.result ? '' : 'placeholder'}}">{{results[resultIndex].label}}</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="filter-row">
      <view class="filter-item half">
        <text class="filter-label">开始日期</text>
        <!-- 原生日期选择器：此前这里只有两个可点的 view（onDateTap 置 showDatePicker，
             但全页没有任何元素消费它），用户点了没有任何反应，日期筛选永远设不上 -->
        <picker mode="date" value="{{filters.startTime}}" bindchange="onDateChange" data-type="startTime">
          <view class="filter-date">
            <text class="{{filters.startTime ? '' : 'placeholder'}}">{{filters.startTime || '不限'}}</text>
          </view>
        </picker>
      </view>
      <view class="filter-item half">
        <text class="filter-label">结束日期</text>
        <picker mode="date" value="{{filters.endTime}}" bindchange="onDateChange" data-type="endTime">
          <view class="filter-date">
            <text class="{{filters.endTime ? '' : 'placeholder'}}">{{filters.endTime || '不限'}}</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="filter-row">
      <view class="filter-item full">
        <text class="filter-label">关键词搜索</text>
        <view class="keyword-input-wrap">
          <input class="filter-input keyword-input" placeholder="搜索操作描述内容" value="{{filters.keyword}}" bindinput="onKeywordInput" maxlength="50" confirm-type="search" />
          <view class="keyword-clear" wx:if="{{filters.keyword}}" bindtap="onClearKeyword" hover-class="btn-hover">
            <text class="keyword-clear-icon">×</text>
          </view>
        </view>
      </view>
    </view>

    <view class="filter-actions">
      <view class="filter-btn clear" bindtap="onClearFilters">重置</view>
      <view class="filter-btn search" bindtap="onSearch">查询</view>
    </view>
  </view>

  <view class="log-list" wx:if="{{!loading && logs.length > 0}}">
    <view class="log-card {{item._expanded ? 'expanded' : ''}}" wx:for="{{logs}}" wx:key="_id" bindtap="onToggleDetail" data-id="{{item._id}}">

      <view class="log-summary">
        <view class="log-line-1">
          <text class="log-module-tag">{{item.moduleLabel}}</text>
          <text class="log-action-tag act-{{item.action}}">{{item.actionLabel}}</text>
          <text class="log-result-tag res-{{item.result}}">{{item.result === 'success' ? '成功' : '失败'}}</text>
        </view>
        <text class="log-desc">{{item.displaySummary}}</text>
        <view class="log-line-2">
          <text class="log-admin">{{item.adminDisplayName || item.adminAccount}}</text>
          <text class="log-time">{{item.timeStr}}</text>
        </view>
      </view>

      <view class="log-detail" wx:if="{{item._expanded}}">
        <view class="detail-section">
          <text class="detail-label">操作账号</text>
          <text class="detail-value">{{item.adminAccount}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">显示名称</text>
          <text class="detail-value">{{item.adminDisplayName}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">操作模块</text>
          <text class="detail-value">{{item.moduleLabel}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">操作类型</text>
          <text class="detail-value">{{item.actionLabel}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">操作结果</text>
          <text class="detail-value {{item.result === 'success' ? 'text-success' : 'text-danger'}}">{{item.result === 'success' ? '成功' : '失败'}}</text>
        </view>
        <view class="detail-section">
          <text class="detail-label">操作时间</text>
          <text class="detail-value">{{item.timeStr}}</text>
        </view>

        <!-- 变更明细：摘要层（changes），替代原先的原始 JSON「数据对比」。
             beforeData/afterData 仍照常写入云端作为审计层，只是不再上界面 ——
             审计数据不因展示口径调整而丢失，管理端也不用再读两坨 JSON。 -->
        <view class="detail-section changes-section" wx:if="{{item.changes.length > 0}}">
          <text class="detail-label">变更明细（{{item.changes.length}} 项）</text>
          <view class="change-list">
            <view class="change-row" wx:for="{{item.changes}}" wx:for-item="change" wx:key="index">
              <text class="change-label">{{change.label}}</text>
              <text class="change-value" wx:if="{{change.text}}">{{change.text}}</text>
              <text class="change-value" wx:else>{{change.from}}<text class="change-arrow"> → </text>{{change.to}}</text>
            </view>
          </view>
        </view>
      </view>

    </view>

    <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">
      <text class="load-more-text">加载更多 ↓ ({{logs.length}}/{{total}})</text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && logs.length === 0 && collectionNotExists}}">
    <icon name="clipboard" size="48" />
    <text class="empty-title">日志集合未创建</text>
    <text class="empty-desc">请在云数据库中创建 operation_logs 集合，或执行一次管理操作后自动生成</text>
  </view>

  <!-- 加载失败态：必须与「暂无操作日志」分开。
       两者过去共用一个空态，于是云端一挂，管理员看到的是「暂无操作日志」，
       会误判成「最近没人操作 / 日志没在工作」，而真相是取不到。
       用 empty-state 组件（带重试按钮），口径同 notice-manage。 -->
  <empty-state
    wx:if="{{!loading && loadFailed && logs.length === 0}}"
    icon="warning"
    title="加载失败了"
    subtitle="没能取到操作日志，稍后再试试"
    showAction="{{true}}"
    actionText="重新加载"
    bindaction="onRetryLoad"
  />

  <view class="empty-state" wx:if="{{!loading && !loadFailed && logs.length === 0 && !collectionNotExists}}">
    <icon name="clipboard" size="48" />
    <text class="empty-title">暂无操作日志</text>
    <text class="empty-desc">管理员执行操作后，日志将自动记录</text>
  </view>

  <view class="skeleton-container" wx:if="{{loading}}">
    <view class="skeleton-card" wx:for="{{skeletonItems}}" wx:key="*this">
      <view class="skeleton-line short skeleton-shimmer"></view>
      <view class="skeleton-line medium skeleton-shimmer"></view>
      <view class="skeleton-line long skeleton-shimmer"></view>
    </view>
  </view>
</view>
