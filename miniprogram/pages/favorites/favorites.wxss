/* 我的关注页面样式 */
.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: var(--bg-secondary);
}
.page-enter { animation: pageEnter 0.4s ease; }

@keyframes pageEnter {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==================== 统计卡片 ==================== */
.stats-section {
  display: flex;
  gap: 24rpx;
  padding: 40rpx 40rpx 24rpx;
}

.stat-card {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 24rpx;
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  background: var(--bg-primary);
  transition: all 0.3s ease;
}
.stat-card:active { transform: scale(0.97); }

.stat-icon-wrap {
  display: flex;
  flex-shrink: 0;
  justify-content: center;
  align-items: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  font-size: 32rpx;
}

/* 类名保持与取值一致：曾叫 stat-icon-pink，但实际填的是品牌暖橘渐变，
   名字会误导后续维护以为这里允许粉系。 */
.stat-icon-brand {
  background: linear-gradient(135deg, var(--primary-light), var(--bg-tertiary));
}

.stat-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stat-number {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -1rpx;
}

.stat-label {
  color: var(--text-tertiary);
  font-size: 24rpx;
  font-weight: 400;
}

/* 关注数与实际取回数不一致时的说明条 */
.missing-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--danger-tint-20);
  border-radius: 16rpx;
  background: var(--danger-tint-12);
  color: var(--danger-color);
  font-size: 24rpx;
  line-height: 1.5;
}

/* ==================== 猫咪列表 ==================== */
.cat-list { padding: 0 40rpx; }
.cat-list.fade-in { animation: fadeIn 0.5s ease both; }

@keyframes fadeIn { from { opacity: 0 } to { opacity: 1 } }

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0 16rpx;
}

.section-title {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.section-count {
  color: var(--text-tertiary);
  font-size: 24rpx;
  font-weight: 400;
}

.cat-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  background: var(--bg-primary);
  transition: all 0.25s ease;
}

.card-hover {
  border-color: var(--primary-tint-15);
  box-shadow: var(--shadow-md);
  transform: translateY(-4rpx);
}

.cat-image-wrap {
  position: relative;
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  overflow: hidden;
  border-radius: 20rpx;
  box-shadow: var(--shadow-xs);
  background: linear-gradient(145deg, var(--bg-primary), var(--primary-light));
}
.cat-image { width: 100%; height: 100%; }

.cat-image-inner {
  display: block;
  width: 100% !important;
  height: 100% !important;
}
.cat-image .lazy-image { width: 100%; height: 100%; }

.cat-emoji {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
  font-size: 52rpx;
}

.cat-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.cat-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.cat-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cat-follow-btn {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;

  /* 触控区 ≥ 88rpx(44px)：此前实测仅约 40rpx，取消关注易误触 */
  min-height: 88rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;

  /* 品牌面 + 白字（口径同主按钮，2026-10-14 维护者定）；
     容器自身也要给 color —— 心形图标走 color: inherit，否则会继承到外面的深字 */
  background: var(--primary-cta-bg);
  color: var(--primary-cta-text);
  transition: all 0.2s ease;
}

.cat-follow-btn:active {
  background: var(--bg-tertiary);
  transform: scale(0.95);
}
.cat-follow-heart { font-size: 22rpx; }

.cat-follow-label {
  /* 按钮已铺品牌底：字色随 --primary-cta-* 自动翻转 */
  color: var(--primary-cta-text);
  font-size: 24rpx;
  font-weight: 500;
}
.cat-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }

.cat-tag {
  max-width: 136rpx;
  padding: 8rpx 16rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: var(--secondary-light);
  color: var(--secondary-color);

  /* 16rpx(8px) 不可读，提到 22rpx */
  font-size: 22rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cat-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}
.cat-location-chip { display: flex; align-items: center; }

/* 原 --secondary-color(#C4A77D) 在白底上仅 ≈2.0:1，改用次级文字色（随主题自动翻转） */
.cat-location-text { color: var(--text-secondary); font-size: 24rpx; }

.cat-duration {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: var(--primary-light);
}
.cat-duration-icon { color: var(--primary-dark); }

.cat-duration-text {
  color: var(--primary-dark);

  /* 16rpx(8px) 不可读，提到 22rpx */
  font-size: 22rpx;
  font-weight: 500;
}

/* ==================== 分页加载 ==================== */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  margin: 0 40rpx;
  padding: 32rpx 0;
}

.load-more-icon {
  color: var(--secondary-color);
  font-size: 24rpx;
  animation: loadArrow 2s ease-in-out infinite;
}

@keyframes loadArrow {
  0%,100% { transform: translateY(0) } 50% { transform: translateY(4rpx) }
}

.load-more text:last-child {
  color: var(--text-tertiary);
  font-size: 24rpx;
  font-weight: 500;
}
.load-more.no-more { display: flex; align-items: center; gap: 16rpx; }

.no-more-line {
  flex: 1;
  max-width: 160rpx;
  height: 8rpx;
  background: linear-gradient(90deg, transparent, var(--text-light), transparent);
}
.no-more-text { color: var(--text-light); font-size: 24rpx; white-space: nowrap; }

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 64rpx;
}

@keyframes emptyFloat {
  0%,100% { transform: translateY(0) } 50% { transform: translateY(-12rpx) }
}

.empty-title {
  margin-bottom: 16rpx;
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.empty-desc {
  margin-bottom: 40rpx;
  color: var(--text-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-btn {
  padding: 24rpx 48rpx;
  border-radius: var(--radius-lg);
  box-shadow: 0 8rpx 40rpx var(--primary-tint-30);

  /* 按钮内 24rpx 文字属小字，需 4.5:1：品牌珊瑚实底 + 深可可字（5.3:1） */
  background: var(--primary-cta-bg);
  transition: all 0.25s ease;
}

.empty-btn text {
  color: var(--primary-cta-text);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
}

/* ==================== 骨架屏 ==================== */
.skeleton-list.visible { animation: fadeIn 0.4s ease both; }
.skeleton { pointer-events: none; }
.skeleton-box { border-radius: 20rpx; background: var(--bg-tertiary); }

.shimmer {
  background: linear-gradient(90deg, var(--bg-tertiary) 25%, var(--bg-warm) 50%, var(--bg-tertiary) 75%);
  background-size: 200% 100%;
  animation: shimmerMove 1.5s infinite;
}

@keyframes shimmerMove {
  0% { background-position: 200% 0 } 100% { background-position: -200% 0 }
}
.skeleton-text { height: 24rpx; border-radius: 8rpx; background: var(--bg-tertiary); }
.skeleton-text.name { width: 70%; height: 24rpx; border-radius: 8rpx; }
.skeleton-text.tag { width: 48rpx; height: 24rpx; border-radius: 12rpx; }
.skeleton-text.tag.short { width: 32rpx; }
.skeleton-text.location { width: 45%; }

/* ==================== 响应式适配 ==================== */
@media (max-width: 360px) {
  .stat-number { font-size: 32rpx; }
  .cat-name { font-size: 24rpx; }
  .cat-image-wrap { width: 96rpx; height: 96rpx; }
}

/* ========== 深色模式 ========== */
@media (prefers-color-scheme: dark) {
  .cat-card { border-color: var(--border-color); background: var(--bg-card); }
  .cat-card:active { background: var(--bg-warm); }
  .stat-card { border-color: var(--border-color); background: var(--bg-card); }
  .cat-tag { background: var(--bg-tertiary); color: var(--text-secondary); }
}
