<!-- 相遇打卡页面 - 日历主视觉布局 -->
<view class="page page-enter">

  <custom-navbar title="相遇打卡" theme="warm" showBack="{{true}}" />

  <!-- ==================== 日历主视觉区 ==================== -->
  <view class="calendar-section">
    <!-- 月份导航 -->
    <view class="cal-nav" id="coach-meets-calendar">
      <view class="cal-nav-btn" bindtap="onPrevMonth" hover-class="cal-nav-btn-hover">
        <text class="cal-nav-arrow">‹</text>
      </view>
      <text class="cal-nav-title">{{calendarYear}}年{{calendarMonth + 1}}月</text>
      <view class="cal-nav-btn" bindtap="onNextMonth" hover-class="cal-nav-btn-hover">
        <text class="cal-nav-arrow">›</text>
      </view>
    </view>

    <!-- 星期标题 -->
    <view class="cal-weekdays">
      <text class="cal-weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
    </view>

    <!-- 日期网格 -->
    <view class="cal-grid">
      <view
        class="cal-cell {{item.day === 0 ? 'cal-cell-empty' : ''}} {{item.future ? 'cal-cell-future' : ''}}"
        wx:for="{{calendarCells}}"
        wx:key="_id"
        bindtap="onTapCell"
        data-day="{{item.day}}"
        data-checked="{{item.checked}}"
        data-future="{{item.future}}"
      >
        <view class="cal-day-wrap {{item.checked ? 'cal-day-checked' : ''}} {{item.isToday ? 'cal-day-today' : ''}} {{item.isToday && item.checked ? 'cal-day-today-checked' : ''}} {{item.selected ? 'cal-day-selected' : ''}}">
          <text class="cal-day-text">{{item.day || ''}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 统计卡片 ==================== -->
  <view class="stats-section" id="coach-meets-stats">
    <view class="stat-card">
      <icon name="paw" size="32" />
      <text class="stat-value">{{statsDisplay.totalDays}}</text>
      <text class="stat-label">累计天数</text>
    </view>
    <view class="stat-card {{stats.streakDays > 0 ? 'stat-card-streak' : ''}}">
      <icon name="fire" size="32" customClass="{{stats.streakDays >= 7 ? 'icon-fire' : ''}}" />
      <text class="stat-value">{{statsDisplay.streakDays}}</text>
      <text class="stat-label">连续天数</text>
    </view>
    <view class="stat-card">
      <icon name="calendar" size="32" />
      <text class="stat-value">{{statsDisplay.monthDays}}</text>
      <text class="stat-label">本月天数</text>
    </view>
  </view>

  <!-- ==================== 打卡日详情 ==================== -->
  <view class="day-detail-section" wx:if="{{selectedDayDetails.length > 0}}">
    <view class="day-detail-header">
      <text class="day-detail-title">{{calendarMonth + 1}}月{{selectedDay}}日 · 相遇{{selectedDayDetails.length}}只猫咪</text>
      <view class="day-detail-close" bindtap="onCloseDayDetail"><icon name="close" size="28" /></view>
    </view>
    <view class="day-detail-list">
      <view
        class="day-detail-card"
        wx:for="{{selectedDayDetails}}"
        wx:key="catId"
        bindtap="onGoToDetail"
        data-cat-id="{{item.catId}}"
        hover-class="card-hover"
      >
        <view class="day-detail-avatar">
          <lazy-image
            wx:if="{{item.catAvatar}}"
            custom-class="day-detail-avatar-inner"
            src="{{item.catAvatar}}"
            type="avatar"
            mode="aspectFill"
            lazy="{{true}}"
          />
          <icon wx:else name="cat" size="32" customClass="day-detail-avatar-fallback" />
        </view>
        <view class="day-detail-info">
          <text class="day-detail-name">{{item.catName || '猫咪'}}</text>
          <view class="inline-row day-detail-location" wx:if="{{item.location}}"><icon name="pin" size="28" /><text>{{item.location}}</text></view>
        </view>
        <view class="day-detail-tag inline-row" wx:if="{{item.statusText}}"><icon name="{{item.statusIcon}}" size="20" /><text>{{item.statusText}}</text></view>
      </view>
    </view>
  </view>

  <!-- ==================== 骨架屏 ==================== -->
  <view class="skeleton-section" wx:if="{{loading}}">
    <view class="skeleton-calendar">
      <view class="skeleton-nav shimmer"></view>
      <view class="skeleton-grid">
        <view class="skeleton-cell shimmer" wx:for="{{skeletonItems}}" wx:key="*this"></view>
      </view>
    </view>
    <view class="skeleton-stats shimmer"></view>
  </view>

  <!-- ==================== 加载失败错误态 ==================== -->
  <empty-state
    wx:if="{{!loading && loadError && meets.length === 0}}"
    icon="warning"
    title="加载失败了"
    subtitle="网络似乎不太顺畅，稍后再试试"
    showAction="{{true}}"
    actionText="重新加载"
    bindaction="onRetryLoad"
  />

  <!-- ==================== 空状态 ==================== -->
  <empty-state
    wx:if="{{!loading && !loadError && meets.length === 0 && stats.totalDays === 0}}"
    icon="paw"
    title="还没有相遇记录"
    subtitle="快去首页逛逛，遇到喜欢的猫咪就打个卡吧~"
    showAction="{{true}}"
    actionText="去看猫咪"
    bindaction="onGoHome"
  />

  <!-- ==================== 最近相遇列表 ==================== -->
  <block wx:if="{{!loading && meetsWithAnim.length > 0}}">
    <view class="list-header" id="coach-meets-list">
      <text class="list-title">最近相遇</text>
      <text class="list-count">共 {{stats.totalDays}} 天</text>
    </view>

    <view class="meet-list">
      <view
        class="meet-card meet-card-enter"
        wx:for="{{meetsWithAnim}}"
        wx:key="_id"
        style="animation-delay: {{item._animIndex * 60}}ms"
        bindtap="onGoToDetail"
        data-cat-id="{{item.catId}}"
        hover-class="card-hover"
      >
        <view class="meet-avatar">
          <lazy-image
            wx:if="{{item.catAvatar}}"
            custom-class="meet-avatar-img"
            src="{{item.catAvatar}}"
            type="avatar"
            mode="aspectFill"
            lazy="{{true}}"
          />
          <icon wx:else name="cat" size="32" customClass="avatar-placeholder" />
        </view>

        <view class="meet-info">
          <view class="meet-name-row">
            <text class="meet-name">{{item.catName || '猫咪'}}</text>
            <text class="meet-location" wx:if="{{item.location}}">{{item.location}}</text>
          </view>
          <view class="meet-meta">
            <view class="meet-status inline-row" wx:if="{{item.statusText}}"><icon name="{{item.statusIcon}}" size="26" /><text>{{item.statusText}}</text></view>
            <text class="meet-note" wx:if="{{item.note}}">{{item.note}}</text>
          </view>
        </view>

        <text class="meet-time">{{item._timeAgo}}</text>
        <text class="meet-arrow">›</text>
      </view>
    </view>

    <!-- 加载中 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <view class="loading-dots">
        <view class="dot"></view><view class="dot"></view><view class="dot"></view>
      </view>
      <text class="load-text">加载中…</text>
    </view>
    <view class="load-more" wx:elif="{{hasMore}}" bindtap="loadMoreMeets" hover-class="btn-hover">
      <text class="load-more-icon">↓</text>
      <text>加载更多</text>
    </view>
    <view class="load-more no-more" wx:elif="{{!hasMore && meets.length > 0}}">
      <view class="no-more-line"></view>
      <view class="inline-row no-more-text"><text>已经到底啦</text><icon name="paw" size="28" /></view>
      <view class="no-more-line"></view>
    </view>
  </block>

  <!-- 回到顶部 -->
  <view class="back-to-top {{showBackToTop ? 'visible' : ''}}" bindtap="onBackToTop" hover-class="btn-hover">
    <text class="back-to-top-icon">↑</text>
  </view>

  <coach-mark
    id="guide-tour"
    show="{{guideTour.show}}"
    selector="{{guideTour.selector}}"
    title="{{guideTour.title}}"
    desc="{{guideTour.desc}}"
    placement="{{guideTour.placement}}"
    step-text="{{guideTour.stepText}}"
    done-text="{{guideTour.doneText}}"
    skip-text="{{guideTour.skipText}}"
    bind:ready="onGuideTourReady"
    bind:missing="onGuideTourMissing"
    bind:done="onGuideTourNext"
    bind:skip="onGuideTourSkip"
  />

</view>
