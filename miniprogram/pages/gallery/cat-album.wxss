/* 单个猫咪相册页面样式 */

.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-warm) 100%);
}

.content-wrapper {
  flex: 1;
  overflow: hidden;
}

.scroll-content {
  height: calc(100vh - 48rpx - env(safe-area-inset-bottom));
}

.cat-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx 32rpx;
  background: var(--bg-primary);
}

.cat-avatar {
  width: 112rpx;
  height: 112rpx;
  border: 4rpx solid var(--primary-color);
  border-radius: 50%;
}

.cat-info {
  flex: 1;
}

.cat-name {
  max-width: 100%;
  margin-bottom: 8rpx;
  overflow: hidden;
  color: var(--text-primary);
  font-size: 36rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cat-count {
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.photos-section {
  padding: 0 24rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding-bottom: 32rpx;
}

.photo-item {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx var(--warm-tint-08);
  background: var(--bg-primary);
  aspect-ratio: 1;
}

.photo-image {
  display: block;
  width: 100%;
  height: 100%;
  background-color: var(--bg-tertiary);
}

.loading-text {
  color: var(--text-tertiary);
  font-size: 28rpx;
  font-weight: 500;
}

.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 160rpx 48rpx;
  text-align: center;
}

.no-more {
  padding: 48rpx 40rpx;
}

.no-more-line {
  width: 100rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--border-color), transparent);
}

.no-more-text {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--text-light);
  font-size: 26rpx;
  font-weight: 500;
}

.skeleton-container {
  padding: 40rpx 24rpx;
}

.skeleton-cat-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: var(--bg-primary);
}

.skeleton-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, var(--border-light) 25%, var(--border-color) 50%, var(--border-light) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.skeleton-cat-info {
  flex: 1;
}

.skeleton-photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.skeleton-photo {
  aspect-ratio: 1;
  border-radius: 24rpx;
  background: linear-gradient(90deg, var(--border-light) 25%, var(--border-color) 50%, var(--border-light) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.skeleton-text {
  border-radius: 12rpx;
  background: linear-gradient(90deg, var(--border-light) 25%, var(--border-color) 50%, var(--border-light) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.skeleton-text.name {
  width: 160rpx;
  height: 40rpx;
  margin-bottom: 16rpx;
}

.skeleton-text.count {
  width: 120rpx;
  height: 28rpx;
}

.bottom-placeholder {
  height: calc(48rpx + env(safe-area-inset-bottom));
}
