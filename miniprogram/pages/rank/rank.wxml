<!-- 猫咪排行榜 -->
<view class="page page-enter">
  <custom-navbar title="猫咪排行榜" theme="warm" showBack="{{true}}" />

  <!-- 类型切换 Tab -->
  <view class="rank-tabs" id="coach-rank-tabs">
    <view
      class="rank-tab {{currentType === 'view' ? 'active' : ''}}"
      bindtap="onSwitchTab"
      data-type="view"
      hover-class="tab-hover"
    >
      <icon class="tab-icon" name="eye" size="36" />
      <text class="tab-label">云吸排行</text>
      <view class="tab-underline" wx:if="{{currentType === 'view'}}"></view>
    </view>
    <view
      class="rank-tab {{currentType === 'fav' ? 'active' : ''}}"
      bindtap="onSwitchTab"
      data-type="fav"
      hover-class="tab-hover"
    >
      <icon class="tab-icon" name="heart-double" size="36" />
      <text class="tab-label">关注排行</text>
      <view class="tab-underline" wx:if="{{currentType === 'fav'}}"></view>
    </view>
    <view
      class="rank-tab {{currentType === 'meet' ? 'active' : ''}}"
      bindtap="onSwitchTab"
      data-type="meet"
      hover-class="tab-hover"
    >
      <icon class="tab-icon" name="paw" size="36" />
      <text class="tab-label">相遇排行</text>
      <view class="tab-underline" wx:if="{{currentType === 'meet'}}"></view>
    </view>
  </view>

  <!-- 骨架屏 -->
  <view class="skeleton-section" wx:if="{{loading}}">
    <view class="skeleton-item" wx:for="{{skeletonItems}}" wx:key="*this">
      <view class="skeleton-rank shimmer"></view>
      <view class="skeleton-avatar shimmer"></view>
      <view class="skeleton-info">
        <view class="skeleton-name shimmer"></view>
        <view class="skeleton-count shimmer"></view>
      </view>
    </view>
  </view>

  <!-- 排行榜列表 -->
  <view class="rank-section" wx:if="{{!loading}}">
    <view class="section-header" id="coach-rank-list">
      <text class="section-title">{{typeMeta.title}}</text>
      <text class="section-desc">共 {{list.length}} 只猫咪上榜</text>
    </view>

    <view class="rank-list" wx:if="{{list.length > 0}}">
      <view
        class="rank-item {{item.rank <= 3 ? 'top3' : ''}} {{item.rank === 1 ? 'gold' : ''}} {{item.rank === 2 ? 'silver' : ''}} {{item.rank === 3 ? 'bronze' : ''}}"
        wx:for="{{list}}"
        wx:key="catId"
        bindtap="onGoToDetail"
        data-cat-id="{{item.catId}}"
        hover-class="item-hover"
      >
        <view class="rank-num">
          <icon wx:if="{{item.rank === 1}}" name="medal-gold" size="40" />
          <icon wx:elif="{{item.rank === 2}}" name="medal-silver" size="40" />
          <icon wx:elif="{{item.rank === 3}}" name="medal-bronze" size="40" />
          <text wx:else class="rank-text">{{item.rank}}</text>
        </view>
        <view class="rank-avatar">
          <lazy-image
            wx:if="{{item.avatar}}"
            class="rank-avatar-img"
            src="{{item.avatar}}"
            type="avatar"
            lazy="{{true}}"
            mode="aspectFill"
            radius="50"
          />
          <icon wx:else class="avatar-placeholder" name="cat" size="48" />
        </view>
        <view class="rank-info">
          <view class="rank-name-row">
            <text class="rank-name">{{item.catName}}</text>
            <text class="rank-campus" wx:if="{{item.campus}}">{{item.campus}}</text>
          </view>
          <view class="rank-meta">
            <text class="rank-count">{{typeMeta.countLabel}} <text class="count-num">{{item.count}}</text> {{typeMeta.countUnit}}</text>
          </view>
        </view>
        <view class="rank-arrow">
          <text>›</text>
        </view>
      </view>
    </view>

    <!-- 加载失败错误态 -->
    <empty-state
      wx:if="{{list.length === 0 && loadError}}"
      icon="warning"
      title="加载失败了"
      subtitle="网络似乎不太顺畅，稍后再试试"
      showAction="{{true}}"
      actionText="重新加载"
      bindaction="onRetryLoad"
    />

    <!-- 空状态 -->
    <empty-state
      wx:if="{{list.length === 0 && !loadError}}"
      icon="{{typeMeta.emptyIcon}}"
      title="暂无排行数据"
      subtitle="{{typeMeta.emptySubtitle}}"
    />

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{list.length > 0 && loadingMore}}">
      <view class="loading-dots">
        <view class="dot"></view><view class="dot"></view><view class="dot"></view>
      </view>
      <text class="load-text">加载中…</text>
    </view>
    <view class="load-more no-more" wx:if="{{list.length > 0 && !loadingMore && !hasMore}}">
      <view class="no-more-line"></view>
      <view class="inline-row no-more-text"><text>已经到底啦</text><icon name="paw" size="28" /></view>
      <view class="no-more-line"></view>
    </view>
  </view>

  <coach-mark
    id="guide-tour"
    show="{{guideTour.show}}"
    selector="{{guideTour.selector}}"
    title="{{guideTour.title}}"
    desc="{{guideTour.desc}}"
    placement="{{guideTour.placement}}"
    step-text="{{guideTour.stepText}}"
    done-text="{{guideTour.doneText}}"
    skip-text="{{guideTour.skipText}}"
    bind:ready="onGuideTourReady"
    bind:missing="onGuideTourMissing"
    bind:done="onGuideTourNext"
    bind:skip="onGuideTourSkip"
  />
</view>
