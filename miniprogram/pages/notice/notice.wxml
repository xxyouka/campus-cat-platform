<!-- 公告列表页面
     不要再给 .page 加 padding-top: {{navBarTotalHeight}}px：
     custom-navbar 的 warm 主题把 position 从 fixed 改成了 relative
     （为了底部圆角渐变参与文档流，见 custom-navbar.wxss 的 .navbar.warm），
     navbar 本身就占位、随内容滚动。此时再加 padding-top 属于**双重避让**，
     会在导航栏上方多出一条空白带。
     正确写法与 admin 各 warm 页面一致：<view class="page page-enter"> -->
<view class="page page-enter">
  <!-- 副标题已移除：主包各二级页统一为「标题 + 返回键」两层结构（见meets / rank / favorites / privacy / notifications） -->
<custom-navbar title="公告栏" theme="warm" showBack="{{true}}" />

  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="notice-list">
      <view class="skeleton-card shimmer" wx:for="{{skeletonItems}}" wx:key="*this">
        <view class="skeleton-header">
          <view class="skeleton-tag skeleton-sm"></view>
          <view class="skeleton-time skeleton-xs"></view>
        </view>
        <view class="skeleton-title skeleton-md"></view>
        <view class="skeleton-content skeleton-sm"></view>
        <view class="skeleton-content skeleton-xs skeleton-mt-sm"></view>
        <view class="skeleton-footer">
          <view class="skeleton-icon skeleton-xs"></view>
        </view>
      </view>
    </view>
  </block>

  <!-- 加载完成后 -->
  <block wx:elif="{{!loading}}">
    <!-- 公告列表 -->
    <view class="notice-list fade-in" id="coach-notice-list" wx:if="{{notices.length > 0}}">
      <view class="notice-card notice-{{item.type || 'default'}}" wx:for="{{notices}}" wx:key="_id" bindtap="onToggleExpand" data-index="{{index}}" hover-class="card-hover" hover-start-time="0" hover-stay-time="100" role="button" aria-label="查看公告：{{item.title}}">
        <view class="notice-side-bar"></view>
        <view class="card-body">
          <view class="card-header">
            <view class="card-tag">
              <text>{{item.type === 'urgent' ? '紧急' : item.type === 'activity' ? '活动' : '公告'}}</text>
            </view>
          </view>
          <text class="card-title">{{item.title}}</text>
          <text class="card-time-sub">{{item.createTimeStr}}</text>
          <text class="card-content {{expandedIndex === index ? 'expanded' : ''}}">{{item.content}}</text>
          <view class="expand-toggle" wx:if="{{item.content.length > 60}}">
            <text>{{expandedIndex === index ? '收起 ▲' : '展开全文 ▼'}}</text>
          </view>
          <view class="card-footer">
            <icon name="cat" size="28" />
            <text class="card-source">校园猫猫</text>
          </view>
        </view>
      </view>

      <!-- 分页加载提示：必须放在 wx:for 的卡片之外。
           2026-10-12 反馈：此前嵌在 .notice-card 内部，而 .notice-card 是横排 flex 容器
           （侧边条 + 正文），提示块被当成第三个子项排到正文右侧 —— 截图中「已经到底啦」
           挤在公告正文旁边，而且每张卡片都会各渲染一份。
           「已经到底啦」按反馈一并撤下，不再使用；只保留加载中 / 加载更多两态。 -->
      <view class="load-more" wx:if="{{loadingMore}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">正在加载…</text>
      </view>
      <view class="load-more" wx:elif="{{hasMore}}" bindtap="loadMoreNotices" hover-class="btn-hover" role="button" aria-label="加载更多公告">
        <view class="inline-row"><icon name="paw" size="28" /><text>加载更多</text></view>
      </view>
    </view>

    <!-- 空状态 -->
    <!-- 网络错误（与列表互斥：仅在无数据可展示时出现，避免叠在已恢复的列表上） -->
    <view class="error-state" wx:if="{{!loading && networkError && notices.length === 0}}">
      <icon name="cat-sad" size="48" />
      <text class="error-text">加载失败</text>
      <view class="retry-btn" bindtap="onRetry" hover-class="btn-hover"><text>重新加载</text></view>
    </view>

    <empty-state
      wx:elif="{{notices.length === 0}}"
      icon="announce"
      title="暂无公告"
      subtitle="管理员发布公告后将在此显示"
    />
  </block>

  <!-- 回到顶部 -->
  <view class="back-to-top {{showBackToTop ? 'visible' : ''}}" bindtap="onBackToTop" hover-class="btn-hover">
    <text class="back-to-top-icon">↑</text>
  </view>

  <coach-mark
    id="guide-tour"
    show="{{guideTour.show}}"
    selector="{{guideTour.selector}}"
    title="{{guideTour.title}}"
    desc="{{guideTour.desc}}"
    placement="{{guideTour.placement}}"
    step-text="{{guideTour.stepText}}"
    done-text="{{guideTour.doneText}}"
    skip-text="{{guideTour.skipText}}"
    bind:ready="onGuideTourReady"
    bind:missing="onGuideTourMissing"
    bind:done="onGuideTourNext"
    bind:skip="onGuideTourSkip"
  />
</view>