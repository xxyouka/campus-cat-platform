<!-- 不要给 .page 加 padding-top让内容避让导航栏：
     custom-navbar 的 warm 主题 position 是 relative（底部圆角渐变需参与文档流），
     navbar 本身已占位。再加 padding-top 属双重避让 → 导航栏上方出现空白带。
     口径与 pages/notice 及 admin 各 warm 页面一致。
     同理不要给 .page 加**横向** padding：navbar 在流内会被一起缩进，
     页头左右各露一条白边。横向留白由各内容块自己承担（见 wxss）。 -->
<view class="page">
  <!-- 标题与「我的」页的「新动态」入口文案对齐；不设副标题（其它二级页同样不设） -->
  <custom-navbar
    title="最新动态"
    theme="warm"
    showBack="{{true}}"
  />

  <!-- 全部已读 -->
  <view class="updates-hint" wx:if="{{hasNewUpdates && !loading}}" bindtap="onViewUpdates" hover-class="btn-press" role="button" aria-label="有新动态，点击更新列表">有新动态，点击查看</view>
  <view class="mark-all-row" wx:if="{{unreadCount > 0}}" bindtap="onMarkAllRead" hover-class="btn-press">
    <icon name="check-circle" size="28" />
    <text class="mark-all-text">全部标记为已读（{{unreadCount}}）</text>
  </view>

  <!-- 列表 -->
  <view class="list" id="coach-notify-list" wx:if="{{!loading && notifications.length > 0}}">
    <view
      class="notify-item {{item.isRead ? 'read' : 'unread'}}"
      wx:for="{{notifications}}"
      wx:key="_id"
      bindtap="onTapNotification"
      data-id="{{item._id}}"
      data-cat-id="{{item.catId}}"
      data-read="{{item.isRead}}"
      hover-class="item-hover"
    >
      <view class="notify-left">
        <image wx:if="{{item.catAvatar}}" class="notify-avatar" src="{{item.catAvatar}}" mode="aspectFill"></image>
        <view wx:else class="notify-avatar placeholder"><icon name="cat" size="36" /></view>
        <view class="notify-dot" wx:if="{{!item.isRead}}"></view>
      </view>
      <view class="notify-body">
        <view class="notify-head">
          <view class="notify-type type-{{item.typeColor}}"><icon name="{{item.typeIcon}}" size="22" /><text>{{item.typeLabel}}</text></view>
          <text class="notify-time">{{item.timeStr}}</text>
        </view>
        <text class="notify-content">{{item.content}}</text>
        <text class="notify-cat" wx:if="{{item.showCatName}}">{{item.catName}}</text>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}">
      <text>{{loadingMore ? '加载中…' : '上拉加载更多'}}</text>
    </view>
    <view class="load-more" wx:else>
      <text class="load-end">已经到底啦</text>
    </view>
  </view>

  <!-- 空状态（复用 empty-state 组件；加载失败走下方错误态） -->
  <empty-state
    wx:if="{{!loading && !loadError && notifications.length === 0}}"
    icon="bell"
    title="暂无动态"
    subtitle="关注猫咪后，TA的动态会出现在这里"
    showAction="{{true}}"
    actionText="去逛逛首页"
    bind:action="onGoBrowse"
  />

  <!-- 加载失败（与真空列表区分，提供重试） -->
  <view class="load-error" wx:if="{{!loading && loadError}}">
    <text class="load-error-text">加载失败，请检查网络后重试</text>
    <view class="load-error-btn" hover-class="btn-press" bindtap="onRetryLoad" role="button" aria-label="重新加载动态">重新加载</view>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="skeleton-item" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this">
      <view class="skeleton-avatar"></view>
      <view class="skeleton-lines">
        <view class="skeleton-line w60"></view>
        <view class="skeleton-line w90"></view>
      </view>
    </view>
  </view>

  <coach-mark
    id="guide-tour"
    show="{{guideTour.show}}"
    selector="{{guideTour.selector}}"
    title="{{guideTour.title}}"
    desc="{{guideTour.desc}}"
    placement="{{guideTour.placement}}"
    step-text="{{guideTour.stepText}}"
    done-text="{{guideTour.doneText}}"
    skip-text="{{guideTour.skipText}}"
    bind:ready="onGuideTourReady"
    bind:missing="onGuideTourMissing"
    bind:done="onGuideTourNext"
    bind:skip="onGuideTourSkip"
  />
</view>
