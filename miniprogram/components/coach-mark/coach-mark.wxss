/* components/coach-mark/coach-mark.wxss - 轻量就地高亮 */

/* 整层不接收点击：页面照常可滚动、可点击；只有气泡本身接收事件 */
.cmk-root {
  position: fixed;
  top: 0;
  left: 0;
  z-index: var(--z-coach, 1050);
  width: 100vw;
  height: 100vh;
  pointer-events: none;
}

.cmk-ring {
  position: fixed;
  z-index: 1051;
  border: 3rpx solid var(--primary-color);
  border-radius: var(--radius-md);
  box-shadow:
    0 0 0 3rpx var(--overlay-white-92),
    0 0 0 9rpx var(--primary-tint-20),
    0 0 24rpx var(--primary-tint-30);
  pointer-events: none;
  animation: cmkRingIn 0.2s ease both;
}

@keyframes cmkRingIn {
  from { opacity: 0; transform: scale(0.98); }
  to   { opacity: 1; transform: scale(1); }
}

.cmk-bubble {
  position: fixed;
  z-index: 1052;
  box-sizing: border-box;
  padding: 22rpx 24rpx 20rpx;
  border: 2rpx solid var(--primary-tint-20);
  border-radius: 24rpx;
  box-shadow:
    0 12rpx 36rpx var(--overlay-black-15),
    0 2rpx 8rpx var(--overlay-black-08);
  background: var(--bg-primary);
  pointer-events: auto;
  animation: cmkBubbleIn 0.2s ease both;
}

@keyframes cmkBubbleIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.cmk-arrow {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  box-shadow: -2rpx -2rpx 4rpx var(--overlay-black-08);
  background: var(--bg-primary);
  transform: rotate(45deg);
}

.cmk-bubble.is-above .cmk-arrow {
  bottom: -8rpx;
}

.cmk-bubble.is-below .cmk-arrow {
  top: -8rpx;
}

.cmk-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
}

.cmk-title {
  flex: 1;
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.cmk-progress {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-pill);
  background: var(--primary-tint-10);
  color: var(--primary-color);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.5;
}

.cmk-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.55;
}

.cmk-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.cmk-skip-all {
  margin-right: auto;
  padding: 6rpx 0;
  color: var(--text-tertiary);
  font-size: 21rpx;
}

.cmk-skip {
  padding: 6rpx 2rpx;
  color: var(--text-tertiary);
  font-size: 22rpx;
}

.cmk-skip-hover {
  opacity: 0.6;
}

.cmk-done {
  display: flex;
  justify-content: center;
  align-items: center;
  min-width: 128rpx;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-pill);
  box-shadow: 0 6rpx 16rpx var(--primary-tint-30);
  background: var(--primary-cta-gradient);
  color: var(--primary-cta-text);
  font-size: 23rpx;
  font-weight: 600;
}

.cmk-done-hover {
  opacity: 0.85;
}
