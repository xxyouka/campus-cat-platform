/* ========== 组件根节点 ========== */
.cm-root {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100vw;
  height: 100vh;
  pointer-events: auto;
}

/* ========== 遮罩层 ========== */
.cm-mask {
  position: absolute;
  inset: 0;
  background: var(--mask-bg-warm);
  backdrop-filter: blur(4px);
}

.cm-mask-enter {
  animation: cmMaskFadeIn 0.25s ease both;
}

.cm-mask-leave {
  animation: cmMaskFadeOut 0.3s ease both;
}

@keyframes cmMaskFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes cmMaskFadeOut {
  from { opacity: 1; }
  to   { opacity: 0; }
}

/* ========== 弹窗主体 ========== */
.cm-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  width: 620rpx;
  max-height: 85vh;
  overflow: hidden;
  border-radius: 40rpx;
  box-shadow:
    var(--shadow-primary-3xl),
    0 8rpx 24rpx var(--overlay-black-08);
  background: var(--bg-primary);
}

.cm-wrap-enter {
  animation: cmSlideUp 0.35s cubic-bezier(0.34, 1.4, 0.64, 1) both;
}

.cm-wrap-leave {
  animation: cmSlideDown 0.25s ease-in both;
}

@keyframes cmSlideUp {
  from {
    opacity: 0;
    transform: translateY(48rpx) scale(0.92);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes cmSlideDown {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  to {
    opacity: 0;
    transform: translateY(24rpx) scale(0.96);
  }
}

/* ========== 顶部装饰渐变条 ========== */
.cm-header-bar {
  position: relative;
  height: 8rpx;
  overflow: hidden;
  background: linear-gradient(90deg, var(--primary-color), var(--gradient-primary-mid), var(--secondary-color), var(--primary-color));
  background-size: 200% 100%;
}

.cm-header-pattern {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, var(--overlay-white-40), transparent);
  animation: cmHeaderShimmer 3s ease-in-out infinite;
}

@keyframes cmHeaderShimmer {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* ========== 图标区域 ========== */
.cm-icon-wrap {
  display: flex;
  justify-content: center;
  padding-top: 48rpx;
  padding-bottom: 8rpx;
}

.cm-icon-circle {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx var(--primary-tint-15);
  background: linear-gradient(135deg, var(--primary-light) 0%, var(--secondary-light) 100%);
}

/* ========== 标题 ========== */
.cm-title {
  padding: 24rpx 40rpx 8rpx;
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5;
  text-align: center;
  letter-spacing: 1rpx;
}

/* ========== 内容区域 ========== */
.cm-body {
  flex: 1;
  min-height: 0;
  max-height: 65vh;
  padding: 16rpx 40rpx 8rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* ========== 内容文字 ========== */
.cm-content {
  margin-bottom: 16rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.8;
  text-align: left;
  letter-spacing: 0.6rpx;
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: break-word;
}

/* ========== 输入框 ========== */
.cm-input-wrap {
  display: flex;
  align-items: center;
  height: 84rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--warm-tint-10);
  border-radius: 12rpx;
  background: var(--bg-warm);
  transition: border-color 0.2s;
}

.cm-input {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  color: var(--text-primary);
  font-size: 24rpx;
}

/* ========== 按钮区 ========== */
.cm-buttons {
  display: flex;
  flex-shrink: 0;
  gap: 24rpx;
  padding: 24rpx 40rpx 40rpx;
}

.cm-one-btn {
  justify-content: center;
}

.cm-btn {
  display: flex;
  flex: 1;
  justify-content: center;
  align-items: center;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: opacity 0.15s;
}

.cm-two-btn .cm-cancel-btn {
  border: none;
  background: var(--skeleton-base);
  color: var(--text-accent);
}

.cm-two-btn .cm-cancel-btn:active {
  background: var(--skeleton-mid);
  opacity: 0.7;
}

.cm-confirm-btn {
  box-shadow: 0 8rpx 24rpx var(--primary-tint-30);

  /* 确认键走品牌珊瑚渐变：底色即品牌色，字用深可可 --primary-cta-text（实底 5.3:1） */
  background: var(--primary-cta-gradient);
  color: var(--primary-cta-text);
}

.cm-confirm-btn:active {
  box-shadow: 0 8rpx 8rpx var(--primary-tint-20);
  opacity: 0.85;
}

.cm-one-btn .cm-confirm-btn {
  box-shadow: 0 8rpx 24rpx var(--primary-tint-30);
  background: var(--primary-cta-gradient);
  color: var(--primary-cta-text);
}

/* ========== 按钮点击效果 ========== */
.cm-btn-hover {
  opacity: 0.8;
}

/* ========== 深色模式 ========== */
@media (prefers-color-scheme: dark) {
  .cm-mask {
    background: var(--mask-bg-dark);
  }

  .cm-input-wrap {
    border-color: var(--border-color);
    background: var(--bg-tertiary);
  }

  .cm-header-pattern {
    background: linear-gradient(90deg, transparent, var(--overlay-white-15), transparent);
  }

  .cm-icon-circle {
    box-shadow: 0 8rpx 24rpx var(--overlay-black-20);
    background: var(--bg-tertiary);
  }

  .cm-two-btn .cm-cancel-btn {
    background: var(--bg-tertiary);
    color: var(--text-secondary);
  }

  .cm-two-btn .cm-cancel-btn:active {
    background: var(--bg-close-active);
  }

  .cm-confirm-btn {
    box-shadow: 0 8rpx 24rpx var(--overlay-black-30);
  }

  .cm-confirm-btn:active {
    box-shadow: 0 8rpx 8rpx var(--overlay-black-20);
  }
}
