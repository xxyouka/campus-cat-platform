/* components/lazy-image/lazy-image.wxss - 懒加载图片组件样式 */

:host {
  display: block;
  width: 100%;
  height: 100%;
}

.lazy-image-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: linear-gradient(135deg, var(--bg-warm) 0%, var(--bg-tertiary) 100%);
}

/* ========== 骨架屏加载动画 ========== */
.skeleton-loader {
  position: absolute;
  inset: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

/* 流光效果 */
.skeleton-shimmer {
  position: absolute;
  inset: 0;
  background: var(--gradient-shimmer-white);
  background-size: 200% 100%;
  animation: shimmer 1.8s ease-in-out infinite;
}

/* ========== 猫咪占位图 ========== */
.cat-placeholder {
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.cat-icon {
  position: relative;
  width: 80rpx;
  height: 70rpx;
  animation: gentle-bounce 2s ease-in-out infinite;
}

@keyframes gentle-bounce {
  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-6rpx);
  }
}

.cat-ear {
  position: absolute;
  top: 0;
  width: 0;
  height: 0;
  border-style: solid;
}

.cat-ear.left {
  left: 8rpx;
  border-width: 0 16rpx 24rpx;
  border-color: transparent transparent var(--secondary-color) transparent;
  transform: rotate(-20deg);
}

.cat-ear.right {
  right: 8rpx;
  border-width: 0 16rpx 24rpx;
  border-color: transparent transparent var(--secondary-color) transparent;
  transform: rotate(20deg);
}

.cat-face {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 64rpx;
  height: 52rpx;
  border-radius: 50% 50% 45% 45%;
  background: linear-gradient(180deg, var(--bg-tertiary) 0%, var(--secondary-color) 100%);
  transform: translateX(-50%);
}

.cat-eye {
  position: absolute;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--text-secondary);
  animation: blink 4s ease-in-out infinite;
}

.cat-eye.left {
  left: 16rpx;
}

.cat-eye.right {
  right: 16rpx;
}

@keyframes blink {
  0%, 45%, 55%, 100% {
    transform: scaleY(1);
  }

  50% {
    transform: scaleY(0.1);
  }
}

.cat-nose {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50% / 60% 60% 40% 40%;
  background: var(--secondary-color);
  transform: translateX(-50%);
}

.cat-mouth {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 8rpx;
  border-bottom: 2rpx solid var(--text-light);
  border-radius: 0 0 50% 50%;
}

.loading-text {
  margin-top: 24rpx;
  color: var(--text-tertiary);
  font-size: 24rpx;
  letter-spacing: 8rpx;
}

/* ========== 图片样式 ========== */
.lazy-image {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
  transition: opacity 0.4s ease;
}

.lazy-image.loaded {
  opacity: 1;
}

/* ========== 错误状态 ========== */.error-placeholder{
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--bg-warm) 0%, var(--bg-tertiary) 100%);
}

.error-text {
  max-width: 100%;
  margin-bottom: 16rpx;
  overflow: hidden;
  color: var(--text-tertiary);
  font-size: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.retry-btn {
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 8rpx var(--secondary-tint-30);
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
  color: var(--bg-primary);
  font-size: 24rpx;
  white-space: nowrap;
  transition: all 0.3s ease;
}

.retry-btn:active {
  transform: scale(0.95);
  box-shadow: 0 8rpx 8rpx var(--secondary-tint-20);
}

/* ========== 不同状态下的容器 ========== */
.lazy-image-wrapper.loading {
  background: linear-gradient(135deg, var(--bg-warm) 0%, var(--bg-tertiary) 100%);
}

.lazy-image-wrapper.loaded {
  background-color: transparent;
}

.lazy-image-wrapper.error {
  background: linear-gradient(135deg, var(--bg-warm) 0%, var(--bg-tertiary) 100%);
}
