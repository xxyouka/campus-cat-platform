<!-- subpackages/feedback/report/report.wxml - 用户反馈（带猫：档案反馈 / 直达：小程序意见） -->
<view class="page">
  <custom-navbar title="{{mode === 'app' ? '意见反馈' : '反馈与上报'}}" theme="warm" showBack="{{true}}" />

  <view class="intro-card" wx:if="{{mode === 'cat'}}">
    <view class="inline-row">
      <icon name="announce" size="34" />
      <text class="intro-title">发现档案有问题？</text>
    </view>
    <text class="intro-text">信息有误、猫咪受伤或需要帮助，都可以在这里告诉管理员。描述越具体，越容易核实。</text>
  </view>

  <view class="intro-card" wx:else>
    <view class="inline-row">
      <icon name="chat" size="34" />
      <text class="intro-title">意见反馈</text>
    </view>
    <text class="intro-text">使用中遇到问题，或有什么好的建议，都可以告诉我们。处理结果会发到「我的 → 动态」。</text>
  </view>

  <block wx:if="{{submitted}}">
    <view class="success-card">
      <icon name="check-circle" size="56" />
      <text class="success-title">已收到，谢谢你</text>
      <text class="success-sub">管理员会尽快核实。处理结果会发到「我的 → 动态」，不用重复提交。</text>
      <view class="success-actions">
        <view class="primary-btn" wx:if="{{mode === 'cat'}}" bindtap="onBackToCat">返回猫咪</view>
        <view class="ghost-btn" bindtap="onBackHome">回首页</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="cat-card" wx:if="{{mode === 'cat' && (catName || catAvatar)}}">
      <image class="cat-avatar" src="{{catAvatar}}" mode="aspectFill" wx:if="{{catAvatar}}" />
      <view class="cat-avatar cat-avatar-placeholder" wx:else>
        <icon name="cat" size="44" />
      </view>
      <view class="cat-info">
        <text class="cat-name">{{catName || '这只猫咪'}}</text>
        <text class="cat-sub">反馈会关联到它的档案</text>
      </view>
    </view>

    <view class="form-card">
      <text class="section-label" id="coach-report-form" wx:if="{{mode === 'cat'}}">反馈类型</text>
      <view class="type-grid" wx:if="{{mode === 'cat'}}">
        <view
          class="type-chip {{type === item.key ? 'active' : ''}}"
          wx:for="{{types}}"
          wx:key="key"
          data-type="{{item.key}}"
          bindtap="onTypeTap"
          hover-class="btn-press"
        >
          <text class="type-label">{{item.label}}</text>
          <text class="type-desc">{{item.desc}}</text>
        </view>
      </view>

      <view class="app-feedback-tag" wx:if="{{mode === 'app'}}">
        <icon name="check-circle" size="28" />
        <text>小程序使用问题或建议</text>
      </view>

      <view class="label-row">
        <text class="section-label">详细描述</text>
        <text class="counter">{{descLength}}/{{descriptionMax}}</text>
      </view>
      <textarea
        class="desc-input"
        value="{{description}}"
        maxlength="{{descriptionMax}}"
        placeholder="{{mode === 'app' ? '例如：某个页面打不开、希望增加某个功能…' : '例如：名字写错了、右耳有个缺口、最近几天没见到…'}}"
        placeholder-class="desc-placeholder"
        bindinput="onInput"
        auto-height
      />
      <text class="form-hint">至少写 {{descriptionMin}} 个字；处理结果会发到「我的 → 动态」。</text>

      <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit" hover-class="btn-press">
        <icon name="{{submitting ? 'clock' : 'check-circle'}}" size="30" />
        <text>{{submitting ? '提交中…' : '提交反馈'}}</text>
      </view>
    </view>
  </block>

  <coach-mark
    id="guide-tour"
    show="{{guideTour.show}}"
    selector="{{guideTour.selector}}"
    title="{{guideTour.title}}"
    desc="{{guideTour.desc}}"
    placement="{{guideTour.placement}}"
    step-text="{{guideTour.stepText}}"
    done-text="{{guideTour.doneText}}"
    skip-text="{{guideTour.skipText}}"
    bind:ready="onGuideTourReady"
    bind:missing="onGuideTourMissing"
    bind:done="onGuideTourNext"
    bind:skip="onGuideTourSkip"
  />
</view>
