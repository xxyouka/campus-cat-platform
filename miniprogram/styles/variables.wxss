  --map-paper: #dfd8c9;
  --map-chip-bg: rgb(255 255 255 / 94%);
  --map-chip-text: #5a4a42;
  --map-chip-border: rgb(139 109 79 / 22%);
  --map-chip-shadow: 0 4rpx 12rpx rgb(96 74 52 / 14%);
  --map-mask-title: #6b6b6b;
  --map-mask-sub: #9a938c;

  /* 圆角 */
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 40rpx;
  --radius-full: 50%;

  /* 真胶囊：非正方形元素必须用这个。
     --radius-full(50%) 是按「宽高各自的 50%」圆角，非正方形会被渲染成椭圆（蛋形）——
     2026-10-12「公告」徽标、2026-10-14「木鱼版」徽标都栽在这上面；
     999rpx 会把四角半径统一压到短边的一半，得到上下平直、两端半圆的胶囊。 */
  --radius-pill: 999rpx;

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 40rpx;
  --space-xxl: 48rpx;

  /* 层级 */
  --z-base: 1;
  --z-dropdown: 100;
  --z-sticky: 200;
  --z-overlay: 900;
  --z-coach: 1050;
  --z-modal: 1000;
  --z-toast: 1100;
}

/* ========== 深色模式：本次新增「深一档」变量的翻转 ==========
 * 深色下品牌色已被 utilities.wxss 提亮（--primary-color #F5A593、--urgent-color #FF6B6B、
 * --status-adoptable #60C060），按钮/标签文字用深色 #1B1816（--bg-primary）压在提亮色上，
 * 对比度 8~10:1，本身达标。
 * 因此这几个「仅供浅色模式压白字」的深一档变量，在深色下直接指回对应的提亮色即可，
 * 既不用另写色值，也不会出现深色模式下的深底深字。
 * --primary-cta-text 同理：浅色模式是白字压品牌珊瑚，深色下底色变提亮珊瑚 #F5A593，
 * 白字只有 1.7:1 → 字色翻回深色（--bg-primary #1B1816，8.99:1）。
 * 变量值里的 var() 在使用处解析（晚于本文件声明），故不影响与 utilities.wxss 的先后顺序。 */
@media (prefers-color-scheme: dark) {
  page {
    --primary-cta-bg: var(--primary-color);
    --primary-cta-gradient: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
    --primary-cta-text: var(--bg-primary);
    --urgent-deep: var(--urgent-color);
    --status-adoptable-deep: var(--status-adoptable);
  }
}
