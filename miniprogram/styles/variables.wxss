/* 全局样式 - 温馨高级感 */
page {
  background-color: var(--bg-secondary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 32rpx;
  line-height: 1.6;
  
  /* 温馨暖色调主色 */
  --primary-color: #E8927C;
  --primary-light: #FDF0EC;
  --primary-dark: #C47A6A;

  /* --primary-deep（暖栗 #8A4B2C）已于 2026-10-14 晚**物理移除**，请勿再添加新 token。
     沿革（防止有人把它捡回来）：深一档的珊瑚红三次被否（#A8543F 棕红 → #B54B30 赤陶
     → #C9401F 鲜珊瑚红）后，曾短暂用过「暖栗 #8A4B2C」，但它在真机复测里仍被嫌为「猪肝红」——
     报告页是最后三个使用点，当晚已按口径改毕。现行口径：
     品牌色只做「面」（按钮底 / 徽标底 / 图标 / 大数字）+ 面上白字（--primary-cta-*）；
     正文与小字一律走暖墨文字色（--text-primary / --text-secondary / --text-tertiary）。 */

  /* 主操作按钮 / 品牌标签（浅色模式）—— 2026-10-14 维护者两轮定案：
     ① 底色用品牌色本身，不再压深（压深 = 品牌色消失，砖红两次被否）
     ② 面上文字用白字（不是深可可），按钮 / 标签全站统一这一套「品牌面 + 白字」
     品牌珊瑚 #E8927C 上白字实测 2.4:1：**这是维护者看过对比度色带后仍选定的观感口径**，
     不再按 4.5:1 小字门槛返工（如需回退：把 --primary-cta-text 改 #4A2B22，即 5.3:1）。
     渐变随之改「品牌主色 → 品牌加深」(#E8927C → #D67B65)，让白字在深端更稳（3.05:1）。
       · --primary-cta-bg（实色）给按钮、标签、徽标底
       · --primary-cta-gradient 给大 CTA
     --primary-cta-text 与底色成套：深色模式下底色是提亮珊瑚 #F5A593，白字只有 1.7:1 不可用，
     故深色下字色翻回深色（--bg-primary #1B1816，8.99:1）—— 这是唯一的深浅差异，已在预览页说明。 */
  --primary-cta-bg: var(--primary-color);
  --primary-cta-gradient: linear-gradient(135deg, var(--primary-color) 0%, var(--gradient-primary-dark) 100%);
  --primary-cta-text: #FFF;
  
  /* 辅助色 - 温暖大地色系 */
  --secondary-color: #C4A77D;
  --secondary-light: #F5EFE5;
  
  /* 渐变中间色 */
  --gradient-primary-mid: #F0B89A;
  --gradient-primary-dark: #D67B65;
  
  /* 功能色 */
  --success-color: #87C48A;
  --warning-color: #F0C48A;
  --danger-color: #E87C7C;
  --info-color: #8AB8E8;

  /* 深一档信息色：小字号徽标等浅底场景使用（--info-color 在浅底上仅 1.9:1） */
  --info-dark: #2F6BA8;
  
  /* 扩展功能色 */
  --urgent-color: #FF3B30;
  --urgent-dark: #E82E2E;

  /* 深一档警报色：白字压 --urgent-color 仅 3.6:1，26rpx 消息类型标签等小字需 4.5:1 */
  --urgent-deep: #C62222;

  /* 错误色：云函数 / 网络失败文案与「点此重试」用（区别于品牌 --danger-color 的粉红，
     这是真正的错误红）。此前各处写的是 var(--error-color, #e64340) 兜底 —— 2026-10-12
     把兜底值提成正式 token，使用点统一改回 var(--error-color) 无兜底口径 */
  --error-color: #E64340;
  --error-tint-10: rgb(230 67 64 / 10%);
  --activity-color: #1890FF;
  --activity-dark: #1677CC;
  --accent-gold: #FFD700;
  --info-light: #7BA8D8;
  --danger-bright: #FF4D4F;
  
  /* 状态色 */
  --status-healthy: #5A9E7C;
  --status-adoptable: #28A745;

  /* 深一档「已找回」色：--status-adoptable 在白底上仅 3.1:1，小字标签不达标 */
  --status-adoptable-deep: #1E7A34;
  --status-feeding: #D4980E;
  --status-missing: #8B7B75;
  
  /* 健康记录类型色 */
  --health-vaccine: #52C41A;
  --health-treatment: #1890FF;
  --health-surgery: #722ED1;
  --health-checkup: #FA8C16;
  --health-medicine: #EB2F96;
  --health-other: #8C8C8C;
  
  /* 健康记录类型浅色 */
  --health-vaccine-light: #73D13D;
  --health-treatment-light: #40A9FF;
  --health-surgery-light: #9254DE;
  --health-checkup-light: #FFA940;
  --health-medicine-light: #F759AB;
  --health-other-light: #BFBFBF;
  
  /* 文字色 - 温暖深灰（primary > secondary > tertiary > light 层级递减） */
  --text-primary: #3D3D3D;
  --text-secondary: #6B6B6B;
  --text-tertiary: #8C8C8C;
  --text-light: #7D7D7D;
  --text-accent: #8B7E74;
  
  /* 背景色 - 温暖米白 */
  --bg-primary: #FFF;
  --bg-secondary: #FDF8F5;
  --bg-tertiary: #F5F2EF;
  --bg-card: #FFF;
  --bg-warm: #FAF6F2;
  --bg-popup: #FFFAF8;
  --bg-close-active: #F0ECE8;
  --bg-dashboard-start: #FFFBF8;
  --bg-dashboard-end: #FFF6F0;
  --bg-share-end: #F5EDE3;
  --bg-card-alt: #FAFAFA;
  --bg-info-tint: #E6F7FF;
  --bg-danger-tint: #FFF1F0;
  
  /* 骨架屏色 */
  --skeleton-base: #F5F0EB;
  --skeleton-mid: #EDE8E3;
  --skeleton-dark: #E8E3DD;
