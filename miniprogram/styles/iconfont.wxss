/* =========================================================
 * styles/iconfont.wxss - 图标字体（AUTO-GENERATED，请勿手改）
 * 生成：npm run build:icons（scripts/build-icons.js）
 * 来源：assets/icons/manifest.js + @phosphor-icons/web（MIT，2026-10-19 生成）
 * 增删图标：改 manifest.js 后重跑构建；深浅色随 currentColor 自动适配
 * ========================================================= */

/* 线性字重：88 个字形，子集 24.4KB */
@font-face {
  font-family: cat-icon;
  src: url('data:font/truetype;charset=utf-8;base64,') format('truetype');
  font-weight: normal;
  font-style: normal;
}

/* 实心字重：3 个字形，子集 1.0KB */
@font-face {
  font-family: cat-icon-fill;
  src: url('data:font/truetype;charset=utf-8;base64,') format('truetype');
  font-weight: normal;
  font-style: normal;
}

/* 线性图标（默认） */
.cat-icon {
  color: currentcolor;
  font-family: cat-icon, cat-icon-fill, sans-serif !important;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
}

/* 实心图标（heart 等 Fill 字重） */
.cat-icon-fill {
  font-family: cat-icon-fill, cat-icon, sans-serif !important;
}
